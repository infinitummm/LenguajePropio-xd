# ==========================================================
# Programa Completo: Datos + Funciones + Control de Flujo :v
# MomoLang XD (.xd)
# ==========================================================

when haces "=== PROCESAMIENTO AVANZADO: CIENCIA DE DATOS Y LOGICA DE PROGRAMA ===" xd

# 1. Definir función para calcular categoría de ventas
momo_funcion clasificar_ticket(promedio)
    si_el_papu promedio >= 100000 entonces
        suelta_el_momo "Venta Alta :v" xd
    sino_callese_senora
        suelta_el_momo "Venta Estandar xd" xd
    fin_del_momo xd
fin_de_la_funcion xd

# 2. Cargar datos tabulares con librerías propias en Python puro
ventas = pasa_el_pack "datos/ventas_prueba.csv" xd

# 3. Pipeline de transformación
ventas_procesadas = ventas 
    |:v> but_te_enteras_que unidades > 2
    |:v> el_futuro_es_hoy_oiste_viejo subtotal = unidades * precio xd

# 4. Agrupamiento y resumen estadístico
resumen = ventas_procesadas 
    |:v> juntar_a_la_grasa_por [ciudad] calcular [
        suma(subtotal) como total_ciudad,
        promedio(subtotal) como promedio_ciudad,
        el_mas_pro(subtotal) como max_venta,
        contar_papus(unidades) como cant_transacciones
    ]
    |:v> ordenar_a_los_papus total_ciudad de_arriba_a_abajo xd

# 5. Exportar el reporte a disco
subir_al_grupo resumen en "salidas/reporte_completo_fase2.csv" xd

# 6. Uso de ciclo y condicional para validar el estado del reporte
contador_lotes = 1 xd
mientras_el_papu contador_lotes <= 2 haz_esto
    when haces "Verificando lote de ejecucion #" + contador_lotes xd
    contador_lotes = contador_lotes + 1 xd
fin_del_bucle xd

categoria_resultado = clasificar_ticket(125000) xd
when haces "Clasificacion del ticket principal: " + categoria_resultado xd

when haces "=== PIPELINE Y CONTROL EJECUTADOS CON EXITO PAPU :v ===" xd
