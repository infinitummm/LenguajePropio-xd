# Demostracion de rutinas personalizadas, toma de decisiones y ciclos
# MomoLang XD (.xd)

when haces "=== EJECUCION DE RUTINAS, CONDICIONALES Y BUCLES ===" xd

# Rutina para cotizar servicio con recargo por urgencia y bono de fidelidad
momo_funcion liquidar_tarifa(monto_servicio, recargo_urgencia, bono_fidelidad)
    costo_recargo = monto_servicio * recargo_urgencia / 100 xd
    tarifa_neta = monto_servicio + costo_recargo - bono_fidelidad xd
    suelta_el_momo tarifa_neta xd
fin_de_la_funcion xd

# Clasificacion del nivel de prioridad segun el valor
momo_funcion calificar_prioridad(valor_total, umbral_alto)
    si_el_papu valor_total >= umbral_alto entonces
        suelta_el_momo "Prioridad Alta :v" xd
    sino_callese_senora
        suelta_el_momo "Prioridad Estandar xd" xd
    fin_del_momo xd
fin_de_la_funcion xd

# Evaluacion de funciones
servicio_base = 180000 xd
porcentaje_urgencia = 15 xd
descuento_cliente = 12000 xd

tarifa_final = liquidar_tarifa(servicio_base, porcentaje_urgencia, descuento_cliente) xd
when haces "Tarifa liquidada con exito: " + tarifa_final xd

estado_servicio = calificar_prioridad(tarifa_final, 150000) xd
when haces "Nivel de atencion asignado: " + estado_servicio xd

# Evaluacion con condicional alternativo
cupo_credito = 420000 xd
when haces "Verificando estado del cupo operativo: " + cupo_credito xd

si_el_papu cupo_credito > 300000 entonces
    when haces "El papu tiene liquidez absoluta :v" xd
sino_callese_senora
    when haces "Fondos reducidos, toca moderar gastos xd" xd
fin_del_momo xd

# Iteracion con ciclo mientras
when haces "Iniciando ciclo mientras_el_papu:" xd
etapa = 1 xd
mientras_el_papu etapa <= 3 haz_esto
    when haces "Procesando lote de sincronizacion #" + etapa xd
    etapa = etapa + 1 xd
fin_del_bucle xd

# Iteracion con ciclo para
when haces "Iniciando ciclo para_cada_papu:" xd
para_cada_papu nivel desde 1 hasta 4 haz_esto
    experiencia = nivel * 150 xd
    when haces "Nivel " + nivel + " acumula EXP: " + experiencia xd
fin_del_bucle xd

when haces "=== FIN DE LA DEMOSTRACION :v ===" xd
