# Filtro rapido, ordenamiento y grafico de dispersion
# MomoLang XD

when haces "Iniciando test de ordenamiento y dispersion..." xd

catalogo = pasa_el_zelda "datos/ventas_prueba.csv" xd

# Seleccionamos columnas de interes y ordenamos los precios mas altos
filtro_precios = catalogo
    |:v> escojo_a_los_papus [unidades, precio]
    |:v> but_ella_no_te_ama precio > 50
    |:v> ordenar_a_los_papus precio de_arriba_a_abajo xd

graficar_momos_en_dispersion filtro_precios titulo "Dispersion Unidades vs Precio" eje_x "Unidades" eje_y "Precio ($)" guardar "salidas/dispersion_momo.svg" xd

guardar_momo filtro_precios en "salidas/datos_ordenados_momo.csv" xd

when haces "Dispersion y tabla guardadas con exito xd" xd
