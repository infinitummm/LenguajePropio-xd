# Test de error sintactico 1: Omision del terminador obligatorio 'xd'
# MomoLang XD (.xd)

when haces "Iniciando prueba sintactica sin cerrar con xd..." xd

# Sentencia invalida sin el 'xd'
ventas = pasa_el_pack "datos/ventas_prueba.csv"

# Sentencia invalida sin el 'xd'
subir_al_grupo ventas en "salidas/ventas.csv"
